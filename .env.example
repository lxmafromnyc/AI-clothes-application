# Copy to .env.local for local development only — never commit the real file.
# In production these are set in the Vercel dashboard or via `vercel env add`.
#
# Every variable here is read only inside the serverless functions in api/.
# None is ever sent to a browser, and none may be prefixed NEXT_PUBLIC_ or
# referenced from anything under assets/ — that would publish the key.

# ---------------------------------------------------------------------------
# Interpreter — understands the request. It never chooses products.
# ---------------------------------------------------------------------------

# Required. Your OpenAI key. Without it the endpoint returns 503 and the
# frontend falls back to local parsing and says so on screen.
OPENAI_API_KEY=

# Optional. Model to call; defaults to gpt-4o-mini.
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Product source — finds the products. It is the only thing that decides
# what a product is, what it costs and where it links to.
# ---------------------------------------------------------------------------

# Required. Your OpenWeb Ninja API key, from https://www.openwebninja.com.
# Sent as the x-api-key header. This is the ONLY variable the product
# search needs: without it /api/search answers 503 and the interface says
# no product source is connected.
OPENWEBNINJA_API_KEY=

# Optional. Which adapter in api/providers/ to use. Left unset, the
# OpenWeb Ninja adapter is used when its key is present. Set it only to
# run a different adapter — a value naming no adapter selects none, so a
# typo shows up as a 503 rather than quietly running something else.
PRODUCT_SOURCE=

# Optional. Marketplace to search. Defaults to us / en.
OPENWEBNINJA_COUNTRY=
OPENWEBNINJA_LANGUAGE=

# Only used when PRODUCT_SOURCE=etsy is set explicitly. Production never
# calls Etsy: the adapter is kept as a working alternative, and nothing
# selects it unless it is named.
ETSY_API_KEY=

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# Required only when the frontend and the functions are on different origins,
# which is the case for GitHub Pages + Vercel. Scheme and host only, no path.
# For this repo: https://lxmafromnyc.github.io
ALLOWED_ORIGIN=
