# Copy to .env.local for local development only — never commit the real file.
# In production these are set in the Vercel dashboard or via `vercel env add`.
#
# Every variable here is read only inside the serverless functions in api/.
# None is ever sent to a browser, and none may be prefixed NEXT_PUBLIC_ or
# referenced from anything under assets/ — that would publish the key.

# ---------------------------------------------------------------------------
# Interpreter — understands the request. It never chooses products.
# ---------------------------------------------------------------------------

# Required. Your OpenAI key. Without it the endpoint returns 503 and the
# frontend falls back to local parsing and says so on screen.
OPENAI_API_KEY=

# Optional. Model to call; defaults to gpt-4o-mini.
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Product source — finds the products. It is the only thing that decides
# what a product is, what it costs and where it links to.
# ---------------------------------------------------------------------------

# Required. Your OpenWeb Ninja API key, from https://www.openwebninja.com.
# Sent as the x-api-key header. This is the ONLY variable the product
# search needs: without it /api/search answers 503 and the interface says
# no product source is connected.
OPENWEBNINJA_API_KEY=

# Optional. Which adapter in api/providers/ to use. Left unset, the
# OpenWeb Ninja adapter is used when its key is present. Set it only to
# run a different adapter — a value naming no adapter selects none, so a
# typo shows up as a 503 rather than quietly running something else.
PRODUCT_SOURCE=

# Optional. Marketplace to search. Defaults to us / en.
OPENWEBNINJA_COUNTRY=
OPENWEBNINJA_LANGUAGE=

# Only used when PRODUCT_SOURCE=etsy is set explicitly. Production never
# calls Etsy: the adapter is kept as a working alternative, and nothing
# selects it unless it is named.
ETSY_API_KEY=

# ---------------------------------------------------------------------------
# Payments — Stripe. Server-side only, always.
#
# None of these may ever be prefixed so a bundler would publish it, and
# none may be read from anything under assets/. The secret key can charge
# cards and read customers; the webhook secret is what proves a delivery
# came from Stripe, and anybody holding it can grant themselves a plan.
# ---------------------------------------------------------------------------

# Required to sell anything. Use the TEST key (sk_test_…) until you are
# ready to take real money — the deployment reports which mode it is in,
# and the pricing page says so on screen. Without this, /api/checkout and
# /api/portal answer 503 and the pricing page says the paid plans cannot
# be bought here.
STRIPE_SECRET_KEY=

# Required for a plan to ever change. The signing secret of the webhook
# endpoint, from its own page in the Stripe dashboard — it starts whsec_
# and is NOT the API key. Without it every delivery is refused, so a
# completed checkout never becomes a plan.
STRIPE_WEBHOOK_SECRET=

# Required, one per paid plan: the Stripe Price the plan is sold at.
# Recurring, monthly, USD — $14.99 for Pro and $79.99 for Max. The
# amounts on the pricing page are display copy; what a shopper is
# actually charged is whatever the Price says, so these two variables are
# what decide it. A plan whose price id is missing cannot be bought, and
# says so, rather than falling back to another price.
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# ---------------------------------------------------------------------------
# Accounts and storage
#
# A subscription has to belong to somebody a webhook can find later, so
# buying a plan needs an account. Searching still does not.
# ---------------------------------------------------------------------------

# Required for accounts. At least 16 characters, and generated rather
# than chosen:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# It keys the HMAC that turns a session token, a verification token, a
# reset token and an OAuth state into the key each is stored under — so
# a dump of the database is not a set of working sessions or links.
#
# Without it, sign-in and sign-up answer 503 rather than issuing
# something forgeable. Changing it signs everybody out and invalidates
# every outstanding verification and reset link, which is exactly what
# you want if you ever think it has leaked.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Sign in with Google
#
# From a Google Cloud project: APIs & Services -> Credentials -> Create
# credentials -> OAuth client ID -> Web application.
#
# The Authorized redirect URI must be exactly, with no query string:
#
#   https://<your-deployment>/api/google-callback
#
# Google matches it character for character. The client secret is read
# only inside the serverless function, sent only to Google over TLS, and
# never reaches a browser — "Continue with Google" is a plain redirect,
# so there is no client-side Google library and nothing to leak into one.
#
# With these unset, the account page does not offer the Google button at
# all and /api/google-start declines rather than half-starting a flow.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Transactional email — verification and password reset
#
# Set ONE provider's key plus EMAIL_FROM. Without both, accounts are
# created unverified and the interface says plainly that no confirmation
# link can be sent — it does not pretend one went out, and it does not
# print the link to a log where it would be a published credential.
#
# Because an unverified account cannot subscribe, email is a real
# dependency of taking money, not an optional extra.
# ---------------------------------------------------------------------------

# Resend — https://resend.com. One key, and a verified sending domain.
RESEND_API_KEY=

# Postmark — https://postmarkapp.com. The SERVER token, not the account
# token. POSTMARK_MESSAGE_STREAM defaults to "outbound".
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=

# Optional. Names which provider to use when more than one key is set.
# A value naming a provider whose key is missing selects none, so a typo
# surfaces as "email is not configured" rather than quietly using the
# other one.
EMAIL_PROVIDER=

# Required to send anything: the From address, on a domain the provider
# has verified. Providers refuse anything else, which is the
# anti-spoofing rule working rather than a setting to fight.
EMAIL_FROM=

# Optional. Where replies go, if not the From address.
EMAIL_REPLY_TO=

# Required in production: where accounts, subscriptions and usage
# counters are kept. Vercel KV supplies the first pair automatically when
# a KV database is attached to the project; Upstash Redis supplies the
# second pair. Either is read.
#
# With neither, the store falls back to memory: it works for local
# development and for the tests, and it forgets everything when the
# function instance is recycled — so a subscription somebody paid for
# would disappear, and so would every account, session and verification
# link. /api/account reports storage.durable=false and the billing pages
# say so on screen.
#
# This is a hard dependency of authentication, not only of billing: with
# no durable store, signing up and signing back in a minute later can
# land on two different function instances and find no account.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# Origins allowed to call the endpoints from a browser, BEYOND the
# deployment's own — which is always allowed and needs no configuration.
# Set this for a frontend on a different origin, e.g. GitHub Pages calling
# functions on Vercel. Scheme and host only, no path. One origin, or
# several separated by commas. A trailing slash is tolerated and stripped.
# For this repo: https://lxmafromnyc.github.io
# Any origin not listed is refused with 403, preflight included.
ALLOWED_ORIGIN=
