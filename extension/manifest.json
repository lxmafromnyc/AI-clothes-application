{
  "manifest_version": 3,
  "name": "Fynd — Fit panel",
  "short_name": "Fynd",
  "version": "0.4.0",
  "description": "Opens beside the clothing product page you're on when you click Fynd, reads the product and its size chart for you to check, and asks Fynd to compare every size with a garment saved on your Fynd profile.",
  "key": "",
  "action": {
    "default_title": "Open Fynd Fit — compare this product with clothes that fit you",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://ai-clothes-application.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
